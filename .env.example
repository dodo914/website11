# =========================================
# LAVA License Server - Environment Config
# =========================================
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# MongoDB connection string for the License Server's OWN database.
# This must be logically separate from any LAVA Store customer database.
LICENSE_SERVER_MONGO_URI=mongodb://localhost:27017/lava_license_server

# Ed25519 PRIVATE signing key (base64, 32-byte seed or 64-byte secret key).
# This key must NEVER leave the License Server.
# NEVER put this in the customer-side LAVA installation, frontend, source
# control, logs, or database.
LICENSE_SERVER_PRIVATE_KEY=

# Optional identifier for which public key / key version corresponds to
# LICENSE_SERVER_PRIVATE_KEY. Useful for future key rotation so the
# customer-side verifier knows which public key to use.
LICENSE_SERVER_PUBLIC_KEY_ID=key-1

# Port the License Server HTTP API listens on.
LICENSE_SERVER_PORT=4000

# Protocol version this server implements. Must match the customer-side
# LAVA verifier's expected protocolVersion.
LICENSE_SERVER_PROTOCOL_VERSION=1

# Shared-secret credential required by the administrative License
# Management API (/api/v1/admin/licenses/...), used only by the future
# Control Panel. Generate a long random value (e.g. `openssl rand -hex
# 32`). NEVER give this to a customer installation — it grants full
# license lifecycle control (create/suspend/revoke/renew/etc).
LICENSE_SERVER_ADMIN_API_KEY=

# Node environment (development | test | production)
NODE_ENV=development
