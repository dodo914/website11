# ============================================================================
# متغيرات بيئة نظام الشحن (Bosta / Aramex / DHL / ShipBlu)
# انسخ الملف ده باسم .env (أو ضيف القيم دي على .env الموجود عندك) واملأ
# القيم الحقيقية بتاعتك. الملف ده مجرد مثال - ممنوع تحط فيه أي secret حقيقي.
# ============================================================================

# ---------------------------------------------------------------------------
# Bosta
# ---------------------------------------------------------------------------
BOSTA_ENABLED=false
# sandbox أو production
BOSTA_ENVIRONMENT=sandbox
BOSTA_API_KEY=
# مفتاح API منفصل لحساب Staging (لو موجود عندك) - لو سبته فاضي هيستخدم BOSTA_API_KEY
BOSTA_SANDBOX_API_KEY=
# اختياري - override كامل لرابط الـAPI بدل القيم الافتراضية (sandbox/production)
BOSTA_BASE_URL=
BOSTA_DEFAULT_RATE=0
BOSTA_PICKUP_ID=
# لازم تحطه وقت إعداد الـWebhook عند بوسطة - شوف رابط الـWebhook تحت
BOSTA_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Aramex
# ---------------------------------------------------------------------------
ARAMEX_ENABLED=false
ARAMEX_ENVIRONMENT=sandbox
ARAMEX_USERNAME=
ARAMEX_PASSWORD=
ARAMEX_ACCOUNT_NUMBER=
ARAMEX_ACCOUNT_PIN=
ARAMEX_ACCOUNT_ENTITY=
ARAMEX_ACCOUNT_COUNTRY_CODE=EG
# بيانات حساب Aramex التجريبي (Sandbox) - لو مش موجودة هيستخدم بيانات الإنتاج نفسها
ARAMEX_SANDBOX_USERNAME=
ARAMEX_SANDBOX_PASSWORD=
ARAMEX_SANDBOX_ACCOUNT_NUMBER=
ARAMEX_SANDBOX_ACCOUNT_PIN=
ARAMEX_SANDBOX_ACCOUNT_ENTITY=
ARAMEX_BASE_URL=
# عنوان نقطة الاستلام (Pickup / Origin) المستخدم في حساب الأسعار والشحن
ARAMEX_PICKUP_ADDRESS=
ARAMEX_PICKUP_CITY=Cairo
ARAMEX_PICKUP_POST_CODE=
ARAMEX_PICKUP_PHONE=
ARAMEX_PICKUP_NAME=
# مطلوب (Mandatory) في هيكل Contact الرسمي بتاع أرامكس مع اسم/تليفون المُرسِل
ARAMEX_PICKUP_EMAIL=

# ---------------------------------------------------------------------------
# DHL Express (MyDHL API)
# ---------------------------------------------------------------------------
DHL_ENABLED=false
DHL_ENVIRONMENT=sandbox
DHL_API_USERNAME=
DHL_API_PASSWORD=
DHL_ACCOUNT_NUMBER=
# بيانات حساب DHL التجريبي (من developer.dhl.com) - مطلوبة لاستخدام سيرفر التست
DHL_SANDBOX_API_USERNAME=
DHL_SANDBOX_API_PASSWORD=
DHL_SANDBOX_ACCOUNT_NUMBER=
DHL_ORIGIN_COUNTRY_CODE=EG
DHL_ORIGIN_CITY=Cairo
DHL_ORIGIN_ADDRESS=
DHL_ORIGIN_POSTAL_CODE=
# مطلوبة (Mandatory) في Contact.fullName/phone الرسمية بتاعة MyDHL API
DHL_ORIGIN_CONTACT_NAME=LAVA Store
DHL_ORIGIN_PHONE=
DHL_BASE_URL=

# ---------------------------------------------------------------------------
# ShipBlu
# ---------------------------------------------------------------------------
SHIPBLU_ENABLED=false
SHIPBLU_ENVIRONMENT=sandbox
SHIPBLU_API_KEY=
# مفتاح API منفصل لحساب Sandbox (لو موجود) - لو مش موجود هيستخدم SHIPBLU_API_KEY
SHIPBLU_SANDBOX_API_KEY=
SHIPBLU_BASE_URL=
# 1: Small, 2: Medium, 3: Large, 4: Extra Large
SHIPBLU_DEFAULT_PACKAGE_SIZE=1
SHIPBLU_DEFAULT_RATE=0
# لازم تحطه وقت إضافة الـWebhook من لوحة تحكم ShipBlu (Integrations)
SHIPBLU_WEBHOOK_SECRET=
